{
  "name": "live-monitor-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:all": "node scripts/dev-all.mjs",
    "build": "next build",
    "start": "next start",
    "test:admin": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/admin-production-path.test.mjs",
    "test:demo": "node --test tests/demo-review-tour.test.mjs",
    "verify:local": "node scripts/verify-local-e2e.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && npm --prefix worker run typecheck",
    "test": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/*.test.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "content:local": "node scripts/curate-local-sites.mjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "animal-island-ui": "^1.2.0",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "three": "0.182.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.187.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
